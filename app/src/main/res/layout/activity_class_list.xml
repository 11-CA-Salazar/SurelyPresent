<?xml version="1.0" encoding="utf-8"?>
    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainFeature.ClassList"
    android:background="@drawable/activity_classlist_background"
    >

    <ImageView
        android:id="@+id/TeachersIcon"
        android:layout_width="179dp"
        android:layout_height="53dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.038"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.023"
        app:srcCompat="@drawable/teachericon" />

    <ImageView
        android:id="@+id/AttendanceList"
        android:layout_width="393dp"
        android:layout_height="256dp"
        android:layout_marginTop="68dp"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/attendancelist" />

    <ImageView
        android:id="@+id/stAgathaList"
        android:layout_width="370dp"
        android:layout_height="108dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.487"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/AttendanceList"
        app:layout_constraintVertical_bias="0.21"
        app:srcCompat="@drawable/st_agathalist" />

    <ImageView
        android:id="@+id/stLeanderList"
        android:layout_width="370dp"
        android:layout_height="108dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.487"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/AttendanceList"
        app:layout_constraintVertical_bias="0.571"
        app:srcCompat="@drawable/st__leanderlist" />

    <ImageView
        android:id="@+id/StLaurenceList"
        android:layout_width="370dp"
        android:layout_height="108dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.487"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/AttendanceList"
        app:layout_constraintVertical_bias="0.976"
        app:srcCompat="@drawable/laurencelist" />

    <ImageView
        android:id="@+id/imageView12"
        android:layout_width="256dp"
        android:layout_height="57dp"
        android:layout_marginTop="4dp"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/AttendanceList"
        app:srcCompat="@drawable/othersectionlist" />
</androidx.constraintlayout.widget.ConstraintLayout>
