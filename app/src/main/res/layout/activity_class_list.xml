<?xml version="1.0" encoding="utf-8"?>
    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainFeature.ClassList"
    android:background="@drawable/activity_classlist_background"
    >

    <ImageView
        android:id="@+id/TeachersIcon"
        android:layout_width="179dp"
        android:layout_height="53dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.021"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.01"
        app:srcCompat="@drawable/teachericon" />

    <ImageView
        android:id="@+id/AttendanceList"
        android:layout_width="187dp"
        android:layout_height="230dp"
        android:layout_marginTop="68dp"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/attendancelist" />

    <ImageView
        android:id="@+id/imageView12"
        android:layout_width="256dp"
        android:layout_height="57dp"
        android:layout_marginTop="16dp"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/AttendanceList"
        app:srcCompat="@drawable/othersectionlist" />

    <ImageButton
        android:id="@+id/imageButton3"
        android:layout_width="373dp"
        android:layout_height="98dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/st_agathalist"
        app:layout_constraintBottom_toTopOf="@+id/imageButton4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView12"
        app:layout_constraintVertical_bias="0.0" />

    <ImageButton
        android:id="@+id/imageButton4"
        android:layout_width="369dp"
        android:layout_height="98dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/st__leanderlist"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toTopOf="@+id/imageButton7"
        app:srcCompat="@drawable/st__leanderlist"
        tools:layout_editor_absoluteX="19dp" />

    <ImageButton
        android:id="@+id/imageButton7"
        android:layout_width="372dp"
        android:layout_height="107dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/laurencelist"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.413"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/laurencelist" />

</androidx.constraintlayout.widget.ConstraintLayout>
