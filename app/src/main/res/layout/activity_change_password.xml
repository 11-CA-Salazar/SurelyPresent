<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="16dp"
        android:paddingEnd="32dp"
        android:paddingBottom="24dp">
        <ImageView
            android:layout_width="150dp"
            android:layout_height="170dp"
            android:contentDescription="School logo"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_shield" />

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_lock_reset" />



        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-condensed"
            android:text="CHANGE PASSWORD"
            android:textColor="#2B2B2B"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Old password -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="14dp">

            <EditText
                android:id="@+id/etOldPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="center_vertical"
                android:hint="Old Password"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:maxLines="1"
                android:textColor="#222222"
                android:textColorHint="#9A9DA1"
                android:textSize="14dp"
                tools:ignore="TextSizeCheck,TouchTargetSizeCheck" />

            <ImageView
                android:id="@+id/ivToggleOld"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Show or hide password"
                android:padding="3dp"
                android:src="@drawable/ic_eye_off" />
        </LinearLayout>

        <!-- New password -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="14dp">

            <EditText
                android:id="@+id/etNewPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="center_vertical"
                android:hint="New Password"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:maxLines="1"
                android:textColor="#222222"
                android:textColorHint="#9A9DA1"
                android:textSize="15sp"
                tools:ignore="TouchTargetSizeCheck" />

            <ImageView
                android:id="@+id/ivToggleNew"
                android:layout_width="28dp"
                android:layout_height="28dp"

                android:contentDescription="Show or hide password"
                android:padding="3dp"
                android:src="@drawable/ic_eye_off" />
        </LinearLayout>

        <!-- Confirm password -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="14dp">

            <EditText
                android:id="@+id/etConfirmNewPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="center_vertical"
                android:hint="Confirm Password"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:maxLines="1"
                android:textColor="#222222"
                android:textColorHint="#9A9DA1"
                android:textSize="15sp"
                tools:ignore="TouchTargetSizeCheck" />

            <ImageView
                android:id="@+id/ivToggleConfirmNew"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Show or hide password"
                android:padding="3dp"
                android:src="@drawable/ic_eye_off" />
        </LinearLayout>

        <Button
            android:id="@+id/btnChangePassword"
            android:layout_width="220dp"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button"
            android:stateListAnimator="@null"
            android:gravity="center_vertical"
            android:textAlignment="center"
            android:text="Change password"
            android:textAllCaps="false"
            android:textColor="#1F2933"
            android:textSize="19sp"
            tools:ignore="RtlCompat" />
    </LinearLayout>
</ScrollView>