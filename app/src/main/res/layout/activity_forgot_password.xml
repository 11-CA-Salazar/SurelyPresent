<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Welcome.ForgotPassword"
    tools:layout_editor_absoluteX="-12dp"
    tools:layout_editor_absoluteY="4dp">


    <ImageView
        android:id="@+id/SecurityLogo"
        android:layout_width="216dp"
        android:layout_height="243dp"
        android:layout_marginTop="4dp"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.482"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/student_list" />

    <ImageView
        android:id="@+id/changePasswordLogo"
        android:layout_width="337dp"
        android:layout_height="140dp"
        android:layout_marginTop="252dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.445"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/SecurityLogo"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/student_list_1_"
        tools:ignore="MissingConstraints" />

    <TextView
        android:id="@+id/oldPasswordField"
        android:layout_width="300dp"
        android:layout_height="51dp"
        android:layout_marginTop="416dp"
        android:background="@drawable/text_bar"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="96sp"
        android:text="@string/old_password"
        android:textAppearance="@style/TextAppearance.AppCompat.Display4"
        android:textSize="16sp"
        android:typeface="sans"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.486"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/newpassworldfield"
        android:layout_width="300dp"
        android:layout_height="51dp"
        android:background="@drawable/text_bar"
        android:lineSpacingExtra="24sp"
        android:text="@string/new_password"
        android:textAlignment="viewStart"
        android:textAllCaps="false"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.486"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/SecurityLogo"
        app:layout_constraintVertical_bias="0.71"
        tools:ignore="TextContrastCheck,VisualLintOverlap" />

    <TextView
        android:id="@+id/confirmPassword"
        android:layout_width="300dp"
        android:layout_height="51dp"
        android:layout_marginTop="560dp"
        android:background="@drawable/text_bar"
        android:text="@string/confirm_password"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.504"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="TextContrastCheck" />

    <Switch
        android:id="@+id/Hide"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:drawableStart="@drawable/hide"
        android:thumb="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.787"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.611"
        tools:ignore="UseSwitchCompatOrMaterialXml,DuplicateSpeakableTextCheck" />

    <Switch
        android:id="@+id/hide2"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:drawableStart="@drawable/hide"
        android:thumb="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.787"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.819"
        tools:ignore="UseSwitchCompatOrMaterialXml" />

    <Switch
        android:id="@+id/hide2"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:drawableStart="@drawable/hide"
        android:thumb="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.787"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.713"
        tools:ignore="DuplicateIds,UseSwitchCompatOrMaterialXml" />

    <ImageButton
        android:id="@+id/imageButton11"
        android:layout_width="219dp"
        android:layout_height="80dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/confirmPassword"
        app:srcCompat="@drawable/changepaswword_removebg_preview"
        tools:ignore="SpeakableTextPresentCheck" />


</androidx.constraintlayout.widget.ConstraintLayout>